# Server Environment Configuration
NODE_ENV=development
PORT=5000

# Security & CORS Whitelist (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:4200,https://petfoodshop-fean.web.app

# Firebase Service Account Secrets (Option 1: Raw JSON string)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Firebase Secrets (Option 2: Individual variables)
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=your-client-email@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Logging Configuration
LOG_LEVEL=info
